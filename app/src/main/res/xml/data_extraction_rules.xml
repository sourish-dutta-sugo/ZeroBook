<?xml version="1.0" encoding="utf-8"?>
<!--
   Harkened data extraction rules for ZeroBook to prevent database and credential leakage.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude database containing PII, financial history, and credentials from cloud backups -->
        <exclude domain="database" path="ZeroBook.db"/>
        <exclude domain="database" path="ZeroBook.db-shm"/>
        <exclude domain="database" path="ZeroBook.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude database containing PII, financial history, and credentials from device-to-device transfer -->
        <exclude domain="database" path="ZeroBook.db"/>
        <exclude domain="database" path="ZeroBook.db-shm"/>
        <exclude domain="database" path="ZeroBook.db-wal"/>
    </device-transfer>
</data-extraction-rules>
